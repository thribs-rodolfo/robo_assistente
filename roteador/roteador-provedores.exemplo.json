      "chave_env": "GROQ_API_KEY",
      "timeout_segundos": 30,
      "habilitado": false
    },
    "gemini": {
      "tipo": "gemini_rest",
      "modelo": "gemini-1.5-flash",
      "chave": "COLE_AQUI",
      "timeout_segundos": 30,
      "habilitado": false
    },
    "ollama_local": {
      "tipo": "ollama",
      "url_base": "http://127.0.0.1:11434",
      "modelo": "qwen2.5:1.5b",
      "timeout_segundos": 180,
      "habilitado": true
    }
  }
}
