    "claude": {
      "tipo": "claude_cli",
      "comando": "claude",
      "timeout_segundos": 120,
      "habilitado": true
    },
    "groq": {
      "tipo": "openai_compat",
      "url_base": "https://api.groq.com/openai/v1",
      "modelo": "llama-3.1-8b-instant",
